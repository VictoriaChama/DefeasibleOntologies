    <!-- https://w3id.org/defeasible/edu-defonto#ActiveLearning -->

    <owl:Class rdf:about="https://w3id.org/defeasible/edu-defonto#ActiveLearning">
        <rdfs:subClassOf rdf:resource="https://w3id.org/defeasible/edu-defonto#LearningActivity"/>
        <rdfs:subClassOf rdf:nodeID="genid4"/>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid4">
        <owl:onProperty rdf:resource="https://w3id.org/defeasible/edu-defonto#increasesUnderstanding"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/defeasible/edu-defonto#Student"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/defeasible/edu-defonto#ActiveLearning"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:resource="https://w3id.org/defeasible/edu-defonto#LearningActivity"/>
        <www:rank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</www:rank>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/defeasible/edu-defonto#ActiveLearning"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid4"/>
        <cair:defeasible rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</cair:defeasible>
        <www:eTransform rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</www:eTransform>
        <www:rank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</www:rank>
    </owl:Axiom>
    


