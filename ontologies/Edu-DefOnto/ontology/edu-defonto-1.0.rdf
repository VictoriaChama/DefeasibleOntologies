    <!-- https://w3id.org/defeasible/edu-defonto#hasCompletionTimeYears -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/defeasible/edu-defonto#hasCompletionTimeYears">
        <rdfs:domain rdf:resource="https://w3id.org/defeasible/edu-defonto#PhDProgram"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/defeasible/edu-defonto#hasCompletionTimeYears"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#domain"/>
        <owl:annotatedTarget rdf:resource="https://w3id.org/defeasible/edu-defonto#PhDProgram"/>
        <www:rank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</www:rank>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/defeasible/edu-defonto#hasCompletionTimeYears"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#range"/>
        <owl:annotatedTarget rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <www:rank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</www:rank>
    </owl:Axiom>
    


