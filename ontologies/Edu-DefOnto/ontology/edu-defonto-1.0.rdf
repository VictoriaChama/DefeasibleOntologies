<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/vicki/ontologies/2026/9/untitled-ontology-33/"
     xml:base="http://www.semanticweb.org/vicki/ontologies/2026/9/untitled-ontology-33/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:pav="http://purl.org/pav/"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:www="http://www.cair.za.net/"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:cair="http://cair.za.net/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/defeasible/edu-defonto">
        <cair:consistent rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</cair:consistent>
        <terms:license rdf:resource="https://creativecommons.org/publicdomain/zero/1.0"/>
        <pav:version rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</pav:version>
        <rdfs:comment xml:lang="en">This ontology models the education and learning path domain with a focus on defeasible knowledge—rules that hold typically but can be overridden by exceptions. It captures common learning patterns, prerequisites, pedagogical methods, and cognitive processes using defeasible subclass axioms, along with explicit defeaters for exceptional cases. The ontology is designed to support reasoning and evaluation with the Defeasible-Inference Platform (DIP) plugin in Protégé, enabling queries over typical rules, exceptions, and contradictions within realistic educational contexts. Typicality axioms are annotated as defeasible for DIP compatibility, while exception cases are modeled through defeater subclasses and conditions</rdfs:comment>
    </owl:Ontology>
    


