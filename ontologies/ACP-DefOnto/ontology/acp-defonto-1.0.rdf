    <!-- https://w3id.org/defeasible/acp-defonto#AIFailSafeSystem -->

    <owl:Class rdf:about="https://w3id.org/defeasible/acp-defonto#AIFailSafeSystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/defeasible/acp-defonto#Agent"/>
        <rdfs:comment xml:lang="en">An automated system designed to monitor operational behavior and intervene when unsafe or out-of-bound conditions are detected. Modeled as an agent capable of issuing mitigations or fail-safe actions and producing telemetry for audit.</rdfs:comment>
        <rdfs:label xml:lang="en">AIFailSafeSystem</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/defeasible/acp-defonto#AIFailSafeSystem"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:resource="https://w3id.org/defeasible/acp-defonto#Agent"/>
        <www:rank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</www:rank>
    </owl:Axiom>
    


