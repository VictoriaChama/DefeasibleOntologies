    <!-- https://w3id.org/defeasible/acp-defonto#accesses -->

    <owl:ObjectProperty rdf:about="https://w3id.org/defeasible/acp-defonto#accesses">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/defeasible/acp-defonto#User"/>
        <rdfs:range rdf:resource="https://w3id.org/defeasible/acp-defonto#Resource"/>
        <rdfs:comment xml:lang="en">A general property indicating that a user accesses a resource.</rdfs:comment>
        <rdfs:label xml:lang="en">accesses</rdfs:label>
    </owl:ObjectProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/defeasible/acp-defonto#accesses"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#domain"/>
        <owl:annotatedTarget rdf:resource="https://w3id.org/defeasible/acp-defonto#User"/>
        <www:rank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</www:rank>
    </owl:Axiom>
